# Локально поднимите БД: docker compose up -d
# Или укажите свой PostgreSQL:
DATABASE_URL="postgresql://postgres:@127.0.0.1:5432/next_pizza?schema=public"

NEXTAUTH_SECRET=замените_на_случайную_строку
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Deepseek (чат-маскот): ключ только здесь, НЕ коммитьте реальный ключ в git
# DEEPSEEK_API_KEY=
# Модель по умолчанию: deepseek-chat. Для новых моделей см. документацию Deepseek:
# DEEPSEEK_MODEL=deepseek-chat
# Для deepseek-v4-pro с режимом thinking (как в документации DeepSeek):
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_THINKING=1
# DEEPSEEK_REASONING_EFFORT=high

# OPENAI_API_KEY=
# RESEND_API_KEY=
