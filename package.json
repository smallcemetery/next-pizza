{
  "name": "next-pizza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "node -e \"console.log('Локальная БД: SQLite (prisma/dev.db). Выполните: npm run db:setup')\"",
    "db:setup": "node prisma/run-with-db.mjs db push && node prisma/run-with-db.mjs db seed",
    "prisma:push": "node prisma/run-with-db.mjs db push",
    "prisma:studio": "node prisma/run-with-db.mjs studio",
    "prisma:seed": "node prisma/run-with-db.mjs db seed",
    "postinstall": "node prisma/run-with-db.mjs generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.13.0",
    "@radix-ui/react-checkbox": "^1.0.4",
